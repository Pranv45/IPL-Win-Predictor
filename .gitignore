# Python virtual environments
venv/
.env/
.venv/

# MLflow experiment runs (do not track)
mlruns/
mlruns.db

# Spark temp files
*.crc

# Python Bytecode Cache
__pycache__/
*.pyc

# DVC cache directory (local)
.dvc/cache/

# Airflow logs
airflow/logs/
logs/

# Docker and build artifacts
*.pid

# Monitoring data (Prometheus / Grafana storage)
monitoring/prometheus-data/
monitoring/alertmanager-data/

# Generated data (DVC will track output separately)
data/processed/
data/features/

# Metrics (DVC will track these)
metrics/*.json

# Models (DVC will track these)
models/*.pkl
models/*.json

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Frontend build output (if any)
frontend/dist/
frontend/node_modules/

# Ignore all untracked by default (optional)
